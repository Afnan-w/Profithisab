# Normalize line endings across editors and platforms.
* text=auto

# Keep data and code files byte-stable so CSV diffs stay clean.
*.csv text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
