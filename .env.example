# Copy to .env.local only if you need to override the public site URL.
# Never commit secrets. This file is safe to commit because it contains no secrets.
#
# Canonicals, sitemap, robots.txt, OG tags and JSON-LD all use this value.
NEXT_PUBLIC_SITE_URL=https://profithisab.vercel.app

# Optional, cookie-free analytics (leave blank to disable).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
